---
// import { MailCheck } from 'lucide-react';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout
    title="Obrigado! - Galvão Coach"
    description="Obrigado pela tua confiança, em breve entraremos em contacto"
>
    <section class="flex flex-col items-center">
        <div class="container py-28 flex flex-col items-center">
            <h1 class="text-4xl font-bold text-center mb-8">
                Obrigado por te registares!
            </h1>
            <p class="text-lg text-center mb-4">
                O teu contacto está guardado e num prazo máximo de 48h
                entraremos em contato contigo.
            </p>
            <a href="/" class="hover:underline">Voltar a página de início</a>
        </div>
    </section>
</Layout>
